{
  "expo": {
    "scheme": "Duitku",
    "name": "duitku",
    "slug": "duitku",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/assets/image.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./src/assets/image.png",
        "backgroundImage": "./src/assets/image.png",
        "monochromeImage": "./src/assets/image.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./src/assets/image.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "@react-native-community/datetimepicker",
      "expo-sharing"
    ]
  }
}
